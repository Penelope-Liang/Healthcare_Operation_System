{
  "name": "healthcare-operation-system",
  "version": "1.0.0",
  "private": true,
  "description": "PHP and MySQL healthcare operations dashboard with JavaScript automation tests.",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:db": "DB_E2E=1 playwright test tests/e2e/database-write.spec.js",
    "test:e2e:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
