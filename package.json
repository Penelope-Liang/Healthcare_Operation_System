{
  "name": "healthcare-operation-system",
  "version": "1.0.0",
  "private": true,
  "description": "Spring Boot healthcare operations dashboard - JavaScript unit and Playwright end-to-end tests.",
  "scripts": {
    "build": "mvn -q -DskipTests package",
    "start": "java -jar target/healthops.jar --spring.profiles.active=demo",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
